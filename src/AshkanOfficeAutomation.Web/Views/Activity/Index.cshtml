@model AshkanOfficeAutomation.Web.Models.ActivityFeedViewModel
@{ ViewData["Title"] = "Activity Feed"; }
<div class="pagehead"><div><h1>رویدادهای سازمانی</h1><p>نمای زمانی عملیات ثبت‌شده در سامانه</p></div></div>
<div class="stats">
 <div class="card"><span>امروز</span><strong>@Model.TodayCount</strong></div>
 <div class="card"><span>۷ روز اخیر</span><strong>@Model.WeekCount</strong></div>
</div>
<div class="panel activity-feed">
@foreach(var item in Model.Events){
 <div class="activity-item"><span class="activity-dot"></span><div><b>@item.Action</b><p>@item.Entity</p><small>@LocalDate.DateTime(item.At.ToLocalTime())</small></div></div>
}
@if(!Model.Events.Any()){<div class="empty-state">هنوز رویدادی ثبت نشده است.</div>}
</div>
