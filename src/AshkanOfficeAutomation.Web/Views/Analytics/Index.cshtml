@{ViewData["Title"]="داشبورد تحلیلی";}
<div class="pagehead"><div><h1>داشبورد تحلیلی مدیریت</h1><p>تصویر لحظه‌ای از مکاتبات، گردش کار و اقدام‌های سازمان</p></div></div>
<div class="stats commandstats"><div class="card"><span>کل مکاتبات</span><strong>@ViewBag.Total</strong></div><div class="card"><span>در جریان</span><strong>@ViewBag.Open</strong></div><div class="card"><span>تکمیل‌شده</span><strong>@ViewBag.Completed</strong></div><div class="card"><span>بایگانی</span><strong>@ViewBag.Archived</strong></div><div class="card dangercard"><span>فوری/آنی</span><strong>@ViewBag.Urgent</strong></div></div>
<div class="grid2"><div class="panel"><h3>مکاتبات بر اساس نوع</h3>@foreach(var x in (IEnumerable<KeyValuePair<string,int>>)ViewBag.ByType){<div class="metricrow"><span>@x.Key</span><b>@x.Value</b></div>}</div><div class="panel"><h3>وضعیت گردش</h3>@foreach(var x in (IEnumerable<KeyValuePair<string,int>>)ViewBag.ByStatus){<div class="metricrow"><span>@x.Key</span><b>@x.Value</b></div>}<div class="metricrow dangertext"><span>وظایف عقب‌افتاده</span><b>@ViewBag.OverdueTasks</b></div></div></div>
