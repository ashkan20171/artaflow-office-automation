@model KnowledgeArticle
@{ViewData["Title"]=Model.Title;}
<article class="panel article"><small>@Model.Category · @LocalDate.DateTime(Model.UpdatedAt)</small><h1>@Model.Title</h1><div class="article-body">@Model.Content</div>@if(!string.IsNullOrWhiteSpace(Model.Keywords)){<p class="muted">کلیدواژه‌ها: @Model.Keywords</p>}</article>
