@model AshkanOfficeAutomation.Web.Models.AiCopilotPageViewModel
@{ViewData["Title"]="AI Copilot";}
<section class="hero-panel"><div><span class="eyebrow">ASHKAN INTELLIGENCE</span><h1>دستیار هوشمند مکاتبات</h1><p>خلاصه‌سازی، تحلیل و پیش‌نویس پاسخ با کنترل نهایی کاربر.</p></div><div class="ai-orb">AI</div></section>
<div class="mini-kpis"><div><span>وظایف باز</span><b>@Model.OpenTasks</b></div><div><span>اعلان خوانده‌نشده</span><b>@Model.UnreadNotifications</b></div><div><span>سررسید ۲۴ ساعت</span><b>@Model.DueSoon</b></div></div>
<div class="ai-workspace"><form asp-action="Analyze" method="post" class="surface"><h3>متن مکاتبه</h3><textarea asp-for="Input.Text" name="Text" rows="12" placeholder="متن نامه را وارد کنید..."></textarea><span asp-validation-for="Input.Text" class="validation"></span><div class="ai-actions"><button class="primary" name="Mode" value="summary">✦ خلاصه</button><button class="soft-btn" name="Mode" value="classify">⌁ تحلیل و اولویت</button><button class="soft-btn" name="Mode" value="reply">↗ پیش‌نویس پاسخ</button></div></form><aside class="surface"><h3>@(Model.Result?.Title??"خروجی Copilot")</h3>@if(Model.Result is null){<div class="empty-rich"><div>✦</div><b>آماده تحلیل</b></div>}else{<pre>@Model.Result.Output</pre><small>@Model.Result.Provider</small>@foreach(var s in Model.Result.Suggestions){<div class="insight-chip">@s</div>}}</aside></div>
<div class="ai-disclaimer">این مرحله از Smart Assistant محلی استفاده می‌کند؛ خروجی باید توسط کاربر بازبینی شود. معماری برای اتصال Provider خارجی آماده است.</div>
