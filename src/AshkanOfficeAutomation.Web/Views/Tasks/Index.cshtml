@model IEnumerable<WorkItem>
@{ViewData["Title"]="وظایف";}
<div class="pagehead"><div><h1>مدیریت وظایف</h1><p>پیگیری اقدام‌ها، موعدها و مسئول انجام</p></div></div>
<div class="grid2"><div class="panel"><h3>وظایف من</h3>@foreach(var x in Model){<div class="task"><div><b>@x.Title</b><p>@x.Description</p><small>@(x.DueAt.HasValue ? LocalDate.DateTime(x.DueAt.Value) : (LocalDate.IsPersian ? "بدون موعد" : "No due date")) · @x.Priority · @x.Status</small></div><form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@x.Id"><select name="status" asp-items="Html.GetEnumSelectList<WorkItemStatus>()"></select><button class="ghost">ثبت</button></form></div>}</div>
@if(User.IsInRole("Administrator")||User.HasClaim("permission","tasks.manage")){<form asp-action="Create" method="post" class="panel"><h3>وظیفه جدید</h3><label>عنوان</label><input name="title" required><label>مسئول</label><select name="assigneeId">@foreach(var u in (IEnumerable<AppUser>)ViewBag.Users){<option value="@u.Id">@u.FullName</option>}</select><label>موعد</label><input name="dueAt" type="datetime-local"><label>اولویت</label><select name="priority" asp-items="Html.GetEnumSelectList<Priority>()"></select><label>شرح</label><textarea name="description"></textarea><button class="btn">ایجاد وظیفه</button></form>}</div>
